{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "sync:docs": {
      "cache": false
    },
    "verify:docs": {
      "dependsOn": ["sync:docs"]
    },
    "ci:docs": {
      "dependsOn": ["verify:docs", "build"],
      "cache": false
    }
  }
}