{
  "name": "luminary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "多产品聚合站 monorepo：官网/文档站、个人网站、桌面客户端",
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "site:dev": "pnpm --filter @luminary/site dev",
    "site:build": "pnpm --filter @luminary/site build",
    "site:sync:docs": "pnpm --filter @luminary/site sync:docs",
    "site:verify:docs": "pnpm --filter @luminary/site verify:docs",
    "personal:dev": "pnpm --filter @luminary/personal dev",
    "personal:build": "pnpm --filter @luminary/personal build",
    "lumine:dev": "pnpm --filter @luminary/lumine dev",
    "lumine:build": "pnpm --filter @luminary/lumine build",
    "lumine:tauri:dev": "pnpm --filter @luminary/lumine tauri:dev",
    "lumine:tauri:build": "pnpm --filter @luminary/lumine tauri:build",
    "sync:docs": "turbo run sync:docs",
    "verify:docs": "turbo run verify:docs",
    "ci:docs": "turbo run ci:docs",
    "check": "pnpm lint && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.5.6"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.0.0",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm check"
  }
}