{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // scripts/ 里的同步脚本由 Node 24 直接执行（原生类型剥离，无打包步骤），
    // Node 的 ESM 解析要求显式写 `.ts` 扩展名（只写 `./sync/run` 会 MODULE_NOT_FOUND）。
    // 因此这里放开扩展名导入；对 next 侧代码没有影响（它们不写扩展名）。
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // 构建产物，类型检查不该看
    "out",
    ".next",
    // compodoc 产物里带 Compodoc 自己的 template-playground 源码（Angular .ts），
    // 那些文件依赖 @angular/*，本站并不安装，也不参与构建——只是作为静态资源整体搬运。
    // 不排除的话 `next build` 的类型检查会去编译它们并报一堆找不到模块。
    "public/compodoc"
  ]
}
