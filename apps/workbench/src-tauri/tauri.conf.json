{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "工作台",
  "version": "0.1.0",
  "identifier": "com.devlujo.workbench",
  "build": {
    "devUrl": "http://localhost:3002",
    "frontendDist": "../.next"
  },
  "app": {
    "windows": [
      {
        "title": "工作台",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
