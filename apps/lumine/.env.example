############
# Lumine environment variables
#
# Copy this file to `.env.local` and adjust the values you need.
# `.env.local` is git-ignored; this example file is committed.
#
# Build-time injection: Vite reads these at build time, so a packaged desktop
# build bakes in whatever was set when it was built. Production and desktop
# values come from CI secrets -- never commit a real address.
#
# Documentation:
# https://vite.dev/guide/env-and-mode#env-files
#
############


############
# Lucent API
#
# Base URL of the Lucent instance, WITHOUT the /api/v1 suffix (the code appends
# it). Defaults to a local Lucent dev instance when unset.
#
# CORS: Lucent's CORS_ORIGIN must list this client's origin, or the preflight
# fails silently -- nothing shows up in Lucent's logs because the request is
# never sent. Local dev needs http://localhost:1420; production needs the real
# web and desktop origins.
#
# Documentation:
# https://github.com/LuoMuLoyal/Lucent/blob/develop/docs/reference/environment-variables.md
#
############
VITE_LUCENT_API_BASE=http://127.0.0.1:3000

# Whether requests carry the httpOnly session cookie. Authentication depends on
# it, so the default is to include; set `omit` only for credential-less probes.
VITE_LUCENT_CREDENTIALS=include


############
# Development session
#
# Injects a local user so the workbench opens without a running Lucent. Useful
# when only the UI is being changed.
#
# Only honoured in development builds: `dev-session.ts` hard-blocks it behind
# `import.meta.env.DEV`, so a production bundle ignores this value entirely.
# It fakes the sign-in state only -- page requests still get 401 and drop the
# session back to anonymous. Start Lucent for real data.
#
############
VITE_LUMINE_MOCK_SESSION=false


############
# Notes
#
# Authentication is an httpOnly cookie session (Lucent's /auth/session/*): the
# browser stores the token and front-end code cannot read it. There are no
# token or secret variables here, and there should not be.
#
############
